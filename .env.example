# Copy to .env and adjust. Every variable is optional except MCP_AUTH_TOKEN over HTTP.
# .env is read from the working directory; real environment variables take precedence.

# ---- MCP transport --------------------------------------------------------------------------

# stdio            the MCP client (Claude Desktop, Claude Code) starts this process and talks
#                  over stdin/stdout; no network, no token (the parent process is trusted).
# streamable-http  listen on MCP_HOST:MCP_PORT; MCP endpoint at /mcp, health check at /healthz;
#                  every request must carry "Authorization: Bearer <MCP_AUTH_TOKEN>".
MCP_TRANSPORT=stdio

# Interface to bind when MCP_TRANSPORT=streamable-http. Use 0.0.0.0 inside a container.
MCP_HOST=127.0.0.1

# TCP port when MCP_TRANSPORT=streamable-http.
MCP_PORT=8000

# Required when MCP_TRANSPORT=streamable-http; the server refuses to start without it.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# ---- Upstream API (Frankfurter, ECB euro reference rates; no key needed) ---------------------

# Base URL of the Frankfurter API, version included. See docs/DECISIONS.md for why this server
# is built against v2.
UPSTREAM_BASE_URL=https://api.frankfurter.dev/v2

# Per-request timeout for upstream calls, in seconds.
HTTP_TIMEOUT_SECONDS=10
